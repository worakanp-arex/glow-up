{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-RAILWAY-APP.up.railway.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://YOUR-RAILWAY-APP.up.railway.app/uploads/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://YOUR-RAILWAY-APP.up.railway.app/socket.io/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
