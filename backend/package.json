{
  "name": "glow-up-backend",
  "version": "1.0.0",
  "description": "Backend API for glow-up",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/config/seedAdmin.js",
    "seed:missions": "node src/config/seedMissions.js",
    "seed:skills": "node src/config/seedSkills.js",
    "seed:demo": "node src/config/seedDemo.js",
    "seed:demo:clean": "node src/config/seedDemo.js --clean",
    "seed:demo:people": "node src/config/seedDemoPeople.js",
    "seed:demo:people:clean": "node src/config/seedDemoPeople.js --clean",
    "seed:demo:full": "node src/config/seedDemo.js && node src/config/seedDemoPeople.js --reset",
    "seed:demo:full:clean": "node src/config/seedDemoPeople.js --clean && node src/config/seedDemo.js --clean",
    "test": "node --import ./test/setup.js --test test/*.test.js",
    "loadtest:seed": "node loadtest/seed.js",
    "loadtest:cleanup": "node loadtest/cleanup.js",
    "loadtest": "node loadtest/run.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "fast-xml-parser": "^5.11.2",
    "file-type": "^22.2.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^10.2.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "socket.io-client": "^4.8.4"
  }
}
