{
  "name": "glow-up-backend",
  "version": "1.0.0",
  "description": "Backend API for glow-up",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/config/seedAdmin.js",
    "seed:missions": "node src/config/seedMissions.js",
    "seed:demo": "node src/config/seedDemo.js",
    "seed:demo:clean": "node src/config/seedDemo.js --clean",
    "test": "node --import ./test/setup.js --test test/*.test.js",
    "loadtest:seed": "node loadtest/seed.js",
    "loadtest:cleanup": "node loadtest/cleanup.js",
    "loadtest": "node loadtest/run.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "fast-xml-parser": "^5.10.1",
    "file-type": "^22.1.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.5.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "socket.io-client": "^4.8.3"
  }
}
