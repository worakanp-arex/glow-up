PORT=5001
MONGODB_URI=mongodb://localhost:27017/glow-up
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
LINE_NOTIFY_TOKEN=

# Google Sign-In (ID token verification only — no client secret needed).
# Create a Web application OAuth Client ID in Google Cloud Console, add
# http://localhost:5173 as an authorized JavaScript origin, then paste the
# Client ID here AND as VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=

# SMTP for OTP, password-reset and family-invite emails (required — there is
# no test mode; emails fail with 503 if these are blank).
# Gmail example: smtp.gmail.com / 587 / your@gmail.com / 16-char App Password
# (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Display sender, e.g. "Glow Up" <your@gmail.com> (defaults to SMTP_USER)
SMTP_FROM=
# Contact shown in every email footer and used as Reply-To
SUPPORT_EMAIL=worakan.p@kkumail.com
