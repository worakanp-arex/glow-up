# development = relaxed checks for working on your own machine. Leave this out
# (or set anything else, e.g. production) on a real server: every other value
# is held to production rules, including a strong JWT_SECRET.
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27017/glow-up
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production with the placeholder below.
JWT_SECRET=change_this_secret
# How long a sign-in lasts (the cookie expires with it). The app holds health
# data, so keep this short; people sign in again after it passes.
JWT_EXPIRES_IN=1d
LINE_NOTIFY_TOKEN=

# Google Sign-In (ID token verification only — no client secret needed).
# Create a Web application OAuth Client ID in Google Cloud Console, add
# http://localhost:5173 as an authorized JavaScript origin, then paste the
# Client ID here AND as VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=

# SMTP for OTP, password-reset and family-invite emails (required — there is
# no test mode; emails fail with 503 if these are blank).
# Gmail example: smtp.gmail.com / 587 / your@gmail.com / 16-char App Password
# (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Display sender, e.g. "Glow Up" <your@gmail.com> (defaults to SMTP_USER)
SMTP_FROM=
# Contact shown in every email footer and used as Reply-To
SUPPORT_EMAIL=worakan.p@kkumail.com

# Alternative to SMTP for hosts that block outbound SMTP (e.g. Railway Free/Trial/Hobby):
# send through Brevo's HTTPS API. Free plan, no card. EMAIL_FROM must be a sender
# address verified in Brevo (Senders & IP > Senders). When set, used instead of SMTP.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Glow Up
