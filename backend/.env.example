PORT=5001
MONGODB_URI=mongodb://localhost:27017/glow-up
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
LINE_NOTIFY_TOKEN=

# Google Sign-In (ID token verification only — no client secret needed).
# Create a Web application OAuth Client ID in Google Cloud Console, add
# http://localhost:5173 as an authorized JavaScript origin, then paste the
# Client ID here AND as VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=

# SMTP for OTP + password-reset emails. Leave blank to use dev-mode, where
# the email content is logged to the console and echoed back in API
# responses (devOtp / devResetUrl) instead of actually being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
