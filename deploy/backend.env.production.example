# Copy to backend/.env on the server and fill in every value.
NODE_ENV=production
PORT=5001
# Listen only on this machine; nginx is the only thing that should reach the API.
HOST=127.0.0.1
TRUST_PROXY=loopback

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/glow-up?retryWrites=true&w=majority

# Your real domain, with https:// and no trailing slash
CORS_ORIGIN=https://YOUR_DOMAIN
FRONTEND_URL=https://YOUR_DOMAIN

# At least 32 random characters — generate with: openssl rand -hex 32
# The server will not start with a short, repeated or example value.
JWT_SECRET=
# How long a sign-in lasts. Short on purpose: this app holds health data.
JWT_EXPIRES_IN=1d

# Google Sign-In (optional). Add https://YOUR_DOMAIN as an Authorized JavaScript origin.
GOOGLE_CLIENT_ID=

# SMTP (required in production). Gmail: use a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_EMAIL=worakan.p@kkumail.com
