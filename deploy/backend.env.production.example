# คัดลอกไปเป็น backend/.env บนเซิร์ฟเวอร์ แล้วกรอกให้ครบทุกค่า
NODE_ENV=production
PORT=5001
# ฟังเฉพาะเครื่องนี้; มีเพียง nginx เท่านั้นที่ควรเข้าถึง API ได้
HOST=127.0.0.1
TRUST_PROXY=loopback

# connection string ของ MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/glow-up?retryWrites=true&w=majority

# โดเมนจริงของคุณ พร้อม https:// และไม่มี / ต่อท้าย
CORS_ORIGIN=https://YOUR_DOMAIN
FRONTEND_URL=https://YOUR_DOMAIN

# สุ่มอย่างน้อย 32 ตัวอักษร — สร้างด้วย: openssl rand -hex 32
# เซิร์ฟเวอร์จะไม่เริ่มทำงานหากค่านี้สั้น ซ้ำรูปแบบ หรือเป็นค่าตัวอย่าง
JWT_SECRET=
# ระยะเวลาที่การล็อกอินมีผล ตั้งให้สั้นโดยตั้งใจ: แอปนี้เก็บข้อมูลสุขภาพ
JWT_EXPIRES_IN=1d

# Google Sign-In (ไม่บังคับ) เพิ่ม https://YOUR_DOMAIN เป็น Authorized JavaScript origin
GOOGLE_CLIENT_ID=

# SMTP (จำเป็นบน production) Gmail: ใช้ App Password 16 ตัวอักษร
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_EMAIL=worakan.p@kkumail.com
